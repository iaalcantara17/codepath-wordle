<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:title="Wordle"
        android:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wordle"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvLabel1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Guess #1"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="30sp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvGuess1"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tvGuess1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="----"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabel1"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvLabel1Check"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Guess #1 Check"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="30sp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintTop_toBottomOf="@id/tvLabel1"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvCheck1"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tvCheck1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="----"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabel1Check"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvLabel2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Guess #2"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="30sp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintTop_toBottomOf="@id/tvLabel1Check"
            android:layout_marginTop="22dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvGuess2"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tvGuess2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="----"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabel2"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvLabel2Check"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Guess #2 Check"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="30sp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintTop_toBottomOf="@id/tvLabel2"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvCheck2"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tvCheck2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="----"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabel2Check"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvLabel3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Guess #3"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="30sp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintTop_toBottomOf="@id/tvLabel2Check"
            android:layout_marginTop="22dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvGuess3"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tvGuess3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="----"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabel3"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvLabel3Check"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Guess #3 Check"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            android:ellipsize="end"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="30sp"
            app:autoSizeStepGranularity="1sp"
            app:layout_constraintTop_toBottomOf="@id/tvLabel3"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvCheck3"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/tvCheck3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="----"
            android:textSize="30sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            app:layout_constraintBaseline_toBaselineOf="@id/tvLabel3Check"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="----"
            android:textSize="64sp"
            android:textColor="@android:color/darker_gray"
            android:maxLines="1"
            android:visibility="invisible"
            android:layout_marginBottom="18dp"
            app:layout_constraintBottom_toTopOf="@id/etGuess"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etGuess"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Enter 4 letter guess here"
            android:inputType="textCapCharacters"
            android:maxLength="4"
            android:textSize="22sp"
            android:layout_marginEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnAction"
            app:layout_constraintBottom_toBottomOf="parent" />

        <Button
            android:id="@+id/btnAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GUESS!"
            app:layout_constraintBaseline_toBaselineOf="@id/etGuess"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
